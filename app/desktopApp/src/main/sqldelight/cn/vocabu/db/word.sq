CREATE TABLE word (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    text TEXT NOT NULL COLLATE NOCASE,
    isPhrase INTEGER NOT NULL,
    phonetic TEXT,
    pos TEXT NOT NULL DEFAULT '' COLLATE NOCASE,
    translation TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    UNIQUE(text, pos)
);

insertWord:
INSERT INTO word(text, isPhrase, phonetic, pos, translation, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectLastInsertId:
SELECT last_insert_rowid();

updateWord:
UPDATE word
SET text = ?, isPhrase = ?, phonetic = ?, pos = ?, translation = ?, updatedAt = ?
WHERE id = ?;

deleteWord:
DELETE FROM word WHERE id = ?;

selectWordById:
SELECT * FROM word WHERE id = ?;

selectAllWords:
SELECT * FROM word ORDER BY id;

selectWordByTextPos:
SELECT * FROM word WHERE text = ? AND pos = ? LIMIT 1;

searchWords:
SELECT * FROM word
WHERE text LIKE ? ESCAPE '\' OR translation LIKE ? ESCAPE '\'
ORDER BY id;

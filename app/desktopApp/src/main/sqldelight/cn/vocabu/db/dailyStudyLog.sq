CREATE TABLE dailyStudyLog (
    date TEXT PRIMARY KEY,
    newWordsLearned INTEGER NOT NULL DEFAULT 0,
    wordsReviewed INTEGER NOT NULL DEFAULT 0,
    sessionTimeSeconds INTEGER NOT NULL DEFAULT 0,
    accuracy REAL NOT NULL DEFAULT 0.0
);

insertLog:
INSERT INTO dailyStudyLog(date, newWordsLearned, wordsReviewed, sessionTimeSeconds, accuracy)
VALUES (?, ?, ?, ?, ?);

updateLog:
UPDATE dailyStudyLog
SET newWordsLearned = ?, wordsReviewed = ?, sessionTimeSeconds = ?, accuracy = ?
WHERE date = ?;

selectLogByDate:
SELECT * FROM dailyStudyLog WHERE date = ?;
